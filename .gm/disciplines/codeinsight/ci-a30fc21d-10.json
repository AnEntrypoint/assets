function flattenVNodes(vnodes, result = []) {
    if (Array.isArray(vnodes)) {
        for (const vnode of vnodes) {
            flattenVNodes(vnode, result);
        }
    }
    else if (isValidVNode(vnodes)) {
        result.push(vnodes);
    }
    return result;
}