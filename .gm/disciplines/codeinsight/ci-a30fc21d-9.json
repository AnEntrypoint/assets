function isValidVNode(vnode) {
    const typeofVNode = typeof vnode;
    return (vnode !== null &&
        vnode !== undefined &&
        (typeofVNode === "string" ||
            typeofVNode === "object" ||
            typeofVNode === "number" ||
            typeofVNode === "bigint"));
}